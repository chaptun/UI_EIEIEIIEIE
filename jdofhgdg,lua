function Library:Window(cfg)
    cfg = cfg or {}
    local title    = cfg.Title or "FluentLib"
    local subtitle = cfg.Desc or cfg.SubTitle or ""
    local keybind  = (cfg.Config and cfg.Config.Keybind) or Enum.KeyCode.LeftControl
    local winSize  = (cfg.Config and cfg.Config.Size) or UDim2.new(0, 420, 0, 380)

    local sg = getGui("FluentLib_" .. title:gsub(" ",""))

    -- ── Drop shadow ───────────────────────────────────────────
    local shadow = makeFrame(sg, UDim2.new(0, winSize.X.Offset+12, 0, winSize.Y.Offset+12),
        UDim2.new(0.5, -(winSize.X.Offset+12)/2, 0.5, -(winSize.Y.Offset+12)/2),
        Color3.fromRGB(0,0,0), 0.55)
    corner(shadow, 14)

    -- ── Main window ───────────────────────────────────────────
    local win = makeFrame(sg, winSize,
        UDim2.new(0.5, -winSize.X.Offset/2, 0.5, -winSize.Y.Offset/2),
        Theme.BG)
    win.Active   = true
    win.Draggable = true
    corner(win, 10)
    stroke(win, Theme.Border, 1, 0.3)

    -- gradient overlay
    local grad = Instance.new("UIGradient", win)
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(28,28,40)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(14,14,20)),
    })
    grad.Rotation = 135

    -- ── Topbar ────────────────────────────────────────────────
    local topbar = makeFrame(win, UDim2.new(1,0,0,50), UDim2.new(0,0,0,0), Theme.SurfaceHigh)
    corner(topbar, 10)
    -- bottom fill to hide bottom corners
    makeFrame(topbar, UDim2.new(1,0,0,10), UDim2.new(0,0,1,-10), Theme.SurfaceHigh, 0)

    local accent = makeFrame(topbar, UDim2.new(0,3,0,28), UDim2.new(0,12,0.5,-14), Theme.Accent)
    corner(accent, 3)

    local titleL = label(topbar, title, 14, Theme.Text, Enum.Font.GothamBold)
    titleL.Size = UDim2.new(1,-80,0,20)
    titleL.Position = UDim2.new(0,22,0,8)

    local subL = label(topbar, subtitle, 11, Theme.TextDim, Enum.Font.Gotham)
    subL.Size = UDim2.new(1,-80,0,16)
    subL.Position = UDim2.new(0,22,0,28)

    -- close button
    local closeBtn = Instance.new("TextButton", topbar)
    closeBtn.Size = UDim2.new(0,28,0,28)
    closeBtn.Position = UDim2.new(1,-36,0.5,-14)
    closeBtn.BackgroundColor3 = Color3.fromRGB(200,60,60)
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.new(1,1,1)
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 12
    closeBtn.BorderSizePixel = 0
    corner(closeBtn, 6)
    closeBtn.MouseButton1Click:Connect(function()
        tween(win, {Size = UDim2.new(0,winSize.X.Offset,0,0)}, 0.2)
        task.wait(0.25)
        sg:Destroy()
    end)

    -- minimize button
    local minBtn = Instance.new("TextButton", topbar)
    minBtn.Size = UDim2.new(0,28,0,28)
    minBtn.Position = UDim2.new(1,-70,0.5,-14)
    minBtn.BackgroundColor3 = Theme.SurfaceHigh
    minBtn.Text = "−"
    minBtn.TextColor3 = Theme.TextDim
    minBtn.Font = Enum.Font.GothamBold
    minBtn.TextSize = 14
    minBtn.BorderSizePixel = 0
    corner(minBtn, 6)
    stroke(minBtn, Theme.Border, 1)

    local minimized = false
    local contentHolder -- reference set below
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            tween(win, {Size = UDim2.new(0, winSize.X.Offset, 0, 50)}, 0.2)
        else
            tween(win, {Size = winSize}, 0.2)
        end
    end)

    -- toggle with keybind
    UserInputService.InputBegan:Connect(function(inp, gpe)
        if gpe then return end
        if inp.KeyCode == keybind then
            win.Visible = not win.Visible
        end
    end)

    -- ── Tab bar ───────────────────────────────────────────────
    local tabBar = makeFrame(win, UDim2.new(1,0,0,32), UDim2.new(0,0,0,50), Theme.Surface)
    local tabBarLayout = Instance.new("UIListLayout", tabBar)
    tabBarLayout.FillDirection = Enum.FillDirection.Horizontal
    tabBarLayout.Padding = UDim.new(0,2)
    local tabBarPad = Instance.new("UIPadding", tabBar)
    tabBarPad.PaddingLeft = UDim.new(0,8)
    tabBarPad.PaddingTop = UDim.new(0,4)

    -- ── Content area ──────────────────────────────────────────
    local contentArea = makeFrame(win, UDim2.new(1,0,1,-82), UDim2.new(0,0,0,82), Theme.BG, 1)
    contentHolder = contentArea

    -- ── Notify layer ──────────────────────────────────────────
    local notifyHolder = Instance.new("Frame", sg)
    notifyHolder.Size = UDim2.new(0,280,1,0)
    notifyHolder.Position = UDim2.new(1,-290,0,0)
    notifyHolder.BackgroundTransparency = 1
    notifyHolder.BorderSizePixel = 0
    local notifyLayout = Instance.new("UIListLayout", notifyHolder)
    notifyLayout.Padding = UDim.new(0,6)
    notifyLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    local notifyPad = Instance.new("UIPadding", notifyHolder)
    notifyPad.PaddingBottom = UDim.new(0,12)
    notifyPad.PaddingRight = UDim.new(0,4)

    -- ── Window object ─────────────────────────────────────────
    local W = setmetatable({}, Library)
    W._sg        = sg
    W._win       = win
    W._tabBar    = tabBar
    W._content   = contentArea
    W._notify    = notifyHolder
    W._tabs      = {}
    W._activeTab = nil

    -- ── Notify method ─────────────────────────────────────────
    function W:Notify(cfg2)
        local ntitle = cfg2.Title or ""
        local ndesc  = cfg2.Desc or ""
        local ntime  = cfg2.Time or 3

        local nf = makeFrame(notifyHolder, UDim2.new(1,0,0,64), nil, Theme.SurfaceHigh)
        corner(nf, 8)
        stroke(nf, Theme.Accent, 1, 0.4)
        nf.BackgroundTransparency = 0.1

        local bar = makeFrame(nf, UDim2.new(0,3,0,44), UDim2.new(0,0,0.5,-22), Theme.Accent)
        corner(bar, 3)

        local tl = label(nf, ntitle, 12, Theme.Text, Enum.Font.GothamBold)
        tl.Size = UDim2.new(1,-16,0,18)
        tl.Position = UDim2.new(0,12,0,8)

        local dl = label(nf, ndesc, 11, Theme.TextDim)
        dl.Size = UDim2.new(1,-16,0,28)
        dl.Position = UDim2.new(0,12,0,26)
        dl.TextWrapped = true

        -- progress bar
        local pbg = makeFrame(nf, UDim2.new(1,0,0,2), UDim2.new(0,0,1,-2), Theme.Border)
        local pb  = makeFrame(pbg, UDim2.new(1,0,1,0), nil, Theme.Accent)
        corner(pbg, 2); corner(pb, 2)
        tween(pb, {Size = UDim2.new(0,0,1,0)}, ntime, Enum.EasingStyle.Linear)

        nf.Size = UDim2.new(1,0,0,0)
        tween(nf, {Size = UDim2.new(1,0,0,64)}, 0.2)
        task.delay(ntime, function()
            tween(nf, {BackgroundTransparency=1, Size=UDim2.new(1,0,0,0)}, 0.2)
            task.wait(0.25); nf:Destroy()
        end)
    end

    -- ── Tab factory ───────────────────────────────────────────
    local function makeTabBtn(name)
        local btn = Instance.new("TextButton", tabBar)
        btn.Size = UDim2.new(0, math.max(60, #name*7+16), 0, 24)
        btn.BackgroundColor3 = Theme.SurfaceHigh
        btn.BackgroundTransparency = 0.6
        btn.Text = name
        btn.TextColor3 = Theme.TextDim
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 11
        btn.BorderSizePixel = 0
        corner(btn, 6)
        return btn
    end

    local function makeScrollFrame()
        local sf = Instance.new("ScrollingFrame", contentArea)
        sf.Size = UDim2.new(1,0,1,0)
        sf.BackgroundTransparency = 1
        sf.BorderSizePixel = 0
        sf.ScrollBarThickness = 3
        sf.ScrollBarImageColor3 = Theme.Accent
        sf.CanvasSize = UDim2.new(0,0,0,0)
        sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
        sf.Visible = false
        local layout = Instance.new("UIListLayout", sf)
        layout.Padding = UDim.new(0,4)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        local pad = Instance.new("UIPadding", sf)
        pad.PaddingLeft = UDim.new(0,8)
        pad.PaddingRight = UDim.new(0,8)
        pad.PaddingTop = UDim.new(0,8)
        pad.PaddingBottom = UDim.new(0,8)
        return sf
    end

    local function activateTab(tabObj)
        for _, t in ipairs(W._tabs) do
            t._scroll.Visible = false
            tween(t._btn, {BackgroundTransparency=0.6, TextColor3=Theme.TextDim}, 0.12)
        end
        tabObj._scroll.Visible = true
        tween(tabObj._btn, {BackgroundTransparency=0, TextColor3=Theme.Text}, 0.12)
        W._activeTab = tabObj
    end

    -- shared Tab/MakeTab builder
    local function buildTab(tcfg)
        tcfg = tcfg or {}
        local tname = tcfg.Title or tcfg.Name or ("Tab"..#W._tabs+1)
        local btn  = makeTabBtn(tname)
        local sf   = makeScrollFrame()

        local T = {_btn=btn, _scroll=sf, _layout=sf:FindFirstChildOfClass("UIListLayout")}

        -- ── Element builders ──────────────────────────────────

        local function rowFrame(h)
            local f = makeFrame(sf, UDim2.new(1,0,0,h or 38), nil, Theme.Surface)
            corner(f, 8)
            stroke(f, Theme.Border, 1, 0.6)
            return f
        end

        -- Section
        local function addSection(scfg)
            scfg = scfg or {}
            local stitle = scfg.Title or scfg.Name or ""
            local sf2 = makeFrame(sf, UDim2.new(1,0,0,24), nil, Theme.BG, 1)
            local line = makeFrame(sf2, UDim2.new(0.4,0,0,1), UDim2.new(0,0,0.5,0), Theme.Border)
            local lineR= makeFrame(sf2, UDim2.new(0.4,0,0,1), UDim2.new(0.6,0,0.5,0), Theme.Border)
            local sl = label(sf2, stitle, 10, Theme.TextDim, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
            sl.Size = UDim2.new(0.2,0,1,0)
            sl.Position = UDim2.new(0.4,0,0,0)
            return sf2
        end

        -- Toggle
        local function addToggle(tcfg2)
            tcfg2 = tcfg2 or {}
            local tname2  = tcfg2.Title or tcfg2.Name or "Toggle"
            local tdesc   = tcfg2.Desc or tcfg2.Description or ""
            local tdefault= tcfg2.Value or tcfg2.Default or false
            local tcb     = tcfg2.Callback or function() end

            local h = tdesc ~= "" and 48 or 36
            local f = rowFrame(h)

            local tl2 = label(f, tname2, 12, Theme.Text, Enum.Font.GothamBold)
            tl2.Size = UDim2.new(1,-64,0,18)
            tl2.Position = UDim2.new(0,12,0,h==48 and 6 or 9)

            if tdesc ~= "" then
                local dl2 = label(f, tdesc, 10, Theme.TextDim)
                dl2.Size = UDim2.new(1,-64,0,16)
                dl2.Position = UDim2.new(0,12,0,26)
            end

            -- pill bg
            local pillBg = makeFrame(f, UDim2.new(0,38,0,20), UDim2.new(1,-50,0.5,-10),
                tdefault and Theme.Toggle_ON or Theme.Toggle_OFF)
            corner(pillBg, 10)
            local pillDot = makeFrame(pillBg, UDim2.new(0,16,0,16), UDim2.new(0,2,0.5,-8),
                Color3.new(1,1,1))
            corner(pillDot, 8)
            if tdefault then
                pillDot.Position = UDim2.new(1,-18,0.5,-8)
            end

            local val = tdefault
            local function setToggle(v)
                val = v
                tween(pillBg, {BackgroundColor3 = v and Theme.Toggle_ON or Theme.Toggle_OFF}, 0.15)
                tween(pillDot, {Position = v and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8)}, 0.15)
                pcall(tcb, v)
            end
            setToggle(tdefault)

            local clickArea = Instance.new("TextButton", f)
            clickArea.Size = UDim2.new(1,0,1,0)
            clickArea.BackgroundTransparency = 1
            clickArea.Text = ""
            clickArea.BorderSizePixel = 0
            clickArea.MouseButton1Click:Connect(function()
                setToggle(not val)
            end)

            -- hover
            clickArea.MouseEnter:Connect(function()
                tween(f, {BackgroundColor3=Theme.SurfaceHigh}, 0.1)
            end)
            clickArea.MouseLeave:Connect(function()
                tween(f, {BackgroundColor3=Theme.Surface}, 0.1)
            end)

            local obj = {}
            function obj:Set(v) setToggle(v) end
            function obj:Get() return val end
            return obj
        end

        -- Button
        local function addButton(bcfg)
            bcfg = bcfg or {}
            local bname = bcfg.Title or bcfg.Name or "Button"
            local bdesc = bcfg.Desc or bcfg.Description or ""
            local bcb   = bcfg.Callback or function() end
            local h = bdesc ~= "" and 48 or 36
            local f = rowFrame(h)

            local accent2 = makeFrame(f, UDim2.new(0,3,0,h-12), UDim2.new(0,0,0.5,-(h-12)/2), Theme.Accent)
            corner(accent2, 3)

            local tl2 = label(f, bname, 12, Theme.TextAccent, Enum.Font.GothamBold)
            tl2.Size = UDim2.new(1,-50,0,18)
            tl2.Position = UDim2.new(0,14,0,h==48 and 6 or 9)

            if bdesc ~= "" then
                local dl2 = label(f, bdesc, 10, Theme.TextDim)
                dl2.Size = UDim2.new(1,-50,0,16)
                dl2.Position = UDim2.new(0,14,0,26)
            end

            local arr = label(f, "›", 16, Theme.Accent, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
            arr.Size = UDim2.new(0,28,1,0)
            arr.Position = UDim2.new(1,-34,0,0)

            local btn2 = Instance.new("TextButton", f)
            btn2.Size = UDim2.new(1,0,1,0)
            btn2.BackgroundTransparency = 1
            btn2.Text = ""
            btn2.BorderSizePixel = 0
            btn2.MouseButton1Click:Connect(function()
                tween(f, {BackgroundColor3=Theme.AccentDark}, 0.08)
                task.delay(0.12, function() tween(f, {BackgroundColor3=Theme.Surface}, 0.1) end)
                pcall(bcb)
            end)
            btn2.MouseEnter:Connect(function() tween(f, {BackgroundColor3=Theme.SurfaceHigh}, 0.1) end)
            btn2.MouseLeave:Connect(function() tween(f, {BackgroundColor3=Theme.Surface}, 0.1) end)
        end

        -- Slider
        local function addSlider(scfg2)
            scfg2 = scfg2 or {}
            local sname = scfg2.Title or scfg2.Name or "Slider"
            local smin  = scfg2.Min or 0
            local smax  = scfg2.Max or 100
            local sval  = scfg2.Value or scfg2.Default or smin
            local sinc  = scfg2.Rounding or scfg2.Increment or 1
            local scb   = scfg2.Callback or function() end

            local f = rowFrame(52)
            local tl2 = label(f, sname, 12, Theme.Text, Enum.Font.GothamBold)
            tl2.Size = UDim2.new(1,-60,0,16)
            tl2.Position = UDim2.new(0,12,0,7)

            local valLbl = label(f, tostring(sval), 12, Theme.Accent, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
            valLbl.Size = UDim2.new(0,50,0,16)
            valLbl.Position = UDim2.new(1,-58,0,7)

            local trackBg = makeFrame(f, UDim2.new(1,-24,0,6), UDim2.new(0,12,0,32), Theme.Border)
            corner(trackBg, 3)
            local trackFill = makeFrame(trackBg, UDim2.new(0,0,1,0), nil, Theme.Accent)
            corner(trackFill, 3)
            local thumb = makeFrame(trackBg, UDim2.new(0,14,0,14), UDim2.new(0,0,0.5,-7), Color3.new(1,1,1))
            corner(thumb, 7)
            stroke(thumb, Theme.AccentDark, 2)

            local function setVal(v)
                v = math.clamp(math.round(v / sinc) * sinc, smin, smax)
                sval = v
                local pct = (v - smin) / (smax - smin)
                tween(trackFill, {Size = UDim2.new(pct, 0, 1, 0)}, 0.1)
                tween(thumb, {Position = UDim2.new(pct, -7, 0.5, -7)}, 0.1)
                valLbl.Text = tostring(v)
                pcall(scb, v)
            end
            setVal(sval)

            local dragging = false
            thumb.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
                    local abs = trackBg.AbsolutePosition
                    local sz  = trackBg.AbsoluteSize
                    local pct = math.clamp((inp.Position.X - abs.X) / sz.X, 0, 1)
                    setVal(smin + (smax - smin) * pct)
                end
            end)
            trackBg.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    local abs = trackBg.AbsolutePosition
                    local sz  = trackBg.AbsoluteSize
                    local pct = math.clamp((inp.Position.X - abs.X) / sz.X, 0, 1)
                    setVal(smin + (smax - smin) * pct)
                end
            end)

            local obj = {}
            function obj:Set(v) setVal(v) end
            function obj:Get() return sval end
            return obj
        end

        -- Dropdown
        local function addDropdown(dcfg)
            dcfg = dcfg or {}
            local dname    = dcfg.Title or dcfg.Name or "Dropdown"
            local doptions = dcfg.Options or dcfg.Values or {}
            local ddefault = dcfg.Value or dcfg.Default or (doptions[1] or "")
            local dcb      = dcfg.Callback or function() end

            local f = rowFrame(38)
            local tl2 = label(f, dname, 12, Theme.Text, Enum.Font.GothamBold)
            tl2.Size = UDim2.new(0.5,0,0,18)
            tl2.Position = UDim2.new(0,12,0.5,-9)

            local selBtn = Instance.new("TextButton", f)
            selBtn.Size = UDim2.new(0.45,0,0,24)
            selBtn.Position = UDim2.new(0.52,0,0.5,-12)
            selBtn.BackgroundColor3 = Theme.SurfaceHigh
            selBtn.Text = ddefault .. " ▾"
            selBtn.TextColor3 = Theme.TextAccent
            selBtn.Font = Enum.Font.Gotham
            selBtn.TextSize = 11
            selBtn.BorderSizePixel = 0
            corner(selBtn, 6)
            stroke(selBtn, Theme.Border, 1)

            local cur = ddefault
            local ddOpen = false
            local ddFrame

            selBtn.MouseButton1Click:Connect(function()
                ddOpen = not ddOpen
                if ddFrame then ddFrame:Destroy(); ddFrame = nil end
                if not ddOpen then return end
                ddFrame = makeFrame(sg._content or sf, UDim2.new(0, selBtn.AbsoluteSize.X+2, 0, math.min(#doptions,5)*28+8),
                    UDim2.new(0, selBtn.AbsolutePosition.X-2, 0, selBtn.AbsolutePosition.Y+28),
                    Theme.SurfaceHigh)
                ddFrame.ZIndex = 20
                corner(ddFrame, 8)
                stroke(ddFrame, Theme.Accent, 1, 0.3)
                ddFrame.Parent = sg

                local ddLayout = Instance.new("UIListLayout", ddFrame)
                ddLayout.Padding = UDim.new(0,2)
                local ddPad = Instance.new("UIPadding", ddFrame)
                ddPad.PaddingTop = UDim.new(0,4)
                ddPad.PaddingLeft = UDim.new(0,4)
                ddPad.PaddingRight = UDim.new(0,4)

                for _, opt in ipairs(doptions) do
                    local ob = Instance.new("TextButton", ddFrame)
                    ob.Size = UDim2.new(1,0,0,24)
                    ob.BackgroundColor3 = opt == cur and Theme.AccentDark or Theme.SurfaceHigh
                    ob.Text = opt
                    ob.TextColor3 = opt == cur and Color3.new(1,1,1) or Theme.TextDim
