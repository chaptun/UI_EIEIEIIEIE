            clickArea.Size = UDim2.new(1,0,1,0)
            clickArea.BackgroundTransparency = 1
            clickArea.Text = ""
            clickArea.BorderSizePixel = 0
            clickArea.MouseButton1Click:Connect(function()
                setToggle(not val)
            end)

            -- hover
            clickArea.MouseEnter:Connect(function()
                tween(f, {BackgroundColor3=Theme.SurfaceHigh}, 0.1)
            end)
            clickArea.MouseLeave:Connect(function()
                tween(f, {BackgroundColor3=Theme.Surface}, 0.1)
            end)

            local obj = {}
            function obj:Set(v) setToggle(v) end
            function obj:Get() return val end
            return obj
        end

        -- Button
        local function addButton(bcfg)
            bcfg = bcfg or {}
            local bname = bcfg.Title or bcfg.Name or "Button"
            local bdesc = bcfg.Desc or bcfg.Description or ""
            local bcb   = bcfg.Callback or function() end
            local h = bdesc ~= "" and 48 or 36
            local f = rowFrame(h)

            local accent2 = makeFrame(f, UDim2.new(0,3,0,h-12), UDim2.new(0,0,0.5,-(h-12)/2), Theme.Accent)
            corner(accent2, 3)

            local tl2 = label(f, bname, 12, Theme.TextAccent, Enum.Font.GothamBold)
            tl2.Size = UDim2.new(1,-50,0,18)
            tl2.Position = UDim2.new(0,14,0,h==48 and 6 or 9)

            if bdesc ~= "" then
                local dl2 = label(f, bdesc, 10, Theme.TextDim)
                dl2.Size = UDim2.new(1,-50,0,16)
                dl2.Position = UDim2.new(0,14,0,26)
            end

            local arr = label(f, "›", 16, Theme.Accent, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
            arr.Size = UDim2.new(0,28,1,0)
            arr.Position = UDim2.new(1,-34,0,0)

            local btn2 = Instance.new("TextButton", f)
            btn2.Size = UDim2.new(1,0,1,0)
            btn2.BackgroundTransparency = 1
            btn2.Text = ""
            btn2.BorderSizePixel = 0
            btn2.MouseButton1Click:Connect(function()
                tween(f, {BackgroundColor3=Theme.AccentDark}, 0.08)
                task.delay(0.12, function() tween(f, {BackgroundColor3=Theme.Surface}, 0.1) end)
                pcall(bcb)
            end)
            btn2.MouseEnter:Connect(function() tween(f, {BackgroundColor3=Theme.SurfaceHigh}, 0.1) end)
            btn2.MouseLeave:Connect(function() tween(f, {BackgroundColor3=Theme.Surface}, 0.1) end)
        end

        -- Slider
        local function addSlider(scfg2)
            scfg2 = scfg2 or {}
            local sname = scfg2.Title or scfg2.Name or "Slider"
            local smin  = scfg2.Min or 0
            local smax  = scfg2.Max or 100
            local sval  = scfg2.Value or scfg2.Default or smin
            local sinc  = scfg2.Rounding or scfg2.Increment or 1
            local scb   = scfg2.Callback or function() end

            local f = rowFrame(52)
            local tl2 = label(f, sname, 12, Theme.Text, Enum.Font.GothamBold)
            tl2.Size = UDim2.new(1,-60,0,16)
            tl2.Position = UDim2.new(0,12,0,7)

            local valLbl = label(f, tostring(sval), 12, Theme.Accent, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
            valLbl.Size = UDim2.new(0,50,0,16)
            valLbl.Position = UDim2.new(1,-58,0,7)

            local trackBg = makeFrame(f, UDim2.new(1,-24,0,6), UDim2.new(0,12,0,32), Theme.Border)
            corner(trackBg, 3)
            local trackFill = makeFrame(trackBg, UDim2.new(0,0,1,0), nil, Theme.Accent)
            corner(trackFill, 3)
            local thumb = makeFrame(trackBg, UDim2.new(0,14,0,14), UDim2.new(0,0,0.5,-7), Color3.new(1,1,1))
            corner(thumb, 7)
            stroke(thumb, Theme.AccentDark, 2)

            local function setVal(v)
                v = math.clamp(math.round(v / sinc) * sinc, smin, smax)
                sval = v
                local pct = (v - smin) / (smax - smin)
                tween(trackFill, {Size = UDim2.new(pct, 0, 1, 0)}, 0.1)
                tween(thumb, {Position = UDim2.new(pct, -7, 0.5, -7)}, 0.1)
                valLbl.Text = tostring(v)
                pcall(scb, v)
            end
            setVal(sval)

            local dragging = false
            thumb.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
                    local abs = trackBg.AbsolutePosition
                    local sz  = trackBg.AbsoluteSize
                    local pct = math.clamp((inp.Position.X - abs.X) / sz.X, 0, 1)
                    setVal(smin + (smax - smin) * pct)
                end
            end)
            trackBg.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    local abs = trackBg.AbsolutePosition
                    local sz  = trackBg.AbsoluteSize
                    local pct = math.clamp((inp.Position.X - abs.X) / sz.X, 0, 1)
                    setVal(smin + (smax - smin) * pct)
                end
            end)

            local obj = {}
            function obj:Set(v) setVal(v) end
            function obj:Get() return sval end
            return obj
        end

        -- Dropdown
        local function addDropdown(dcfg)
            dcfg = dcfg or {}
            local dname    = dcfg.Title or dcfg.Name or "Dropdown"
            local doptions = dcfg.Options or dcfg.Values or {}
            local ddefault = dcfg.Value or dcfg.Default or (doptions[1] or "")
            local dcb      = dcfg.Callback or function() end

            local f = rowFrame(38)
            local tl2 = label(f, dname, 12, Theme.Text, Enum.Font.GothamBold)
            tl2.Size = UDim2.new(0.5,0,0,18)
            tl2.Position = UDim2.new(0,12,0.5,-9)

            local selBtn = Instance.new("TextButton", f)
            selBtn.Size = UDim2.new(0.45,0,0,24)
            selBtn.Position = UDim2.new(0.52,0,0.5,-12)
            selBtn.BackgroundColor3 = Theme.SurfaceHigh
            selBtn.Text = ddefault .. " ▾"
            selBtn.TextColor3 = Theme.TextAccent
            selBtn.Font = Enum.Font.Gotham
            selBtn.TextSize = 11
            selBtn.BorderSizePixel = 0
            corner(selBtn, 6)
            stroke(selBtn, Theme.Border, 1)

            local cur = ddefault
            local ddOpen = false
            local ddFrame

            selBtn.MouseButton1Click:Connect(function()
                ddOpen = not ddOpen
                if ddFrame then ddFrame:Destroy(); ddFrame = nil end
                if not ddOpen then return end
                ddFrame = makeFrame(sg._content or sf, UDim2.new(0, selBtn.AbsoluteSize.X+2, 0, math.min(#doptions,5)*28+8),
                    UDim2.new(0, selBtn.AbsolutePosition.X-2, 0, selBtn.AbsolutePosition.Y+28),
                    Theme.SurfaceHigh)
                ddFrame.ZIndex = 20
                corner(ddFrame, 8)
                stroke(ddFrame, Theme.Accent, 1, 0.3)
                ddFrame.Parent = sg

                local ddLayout = Instance.new("UIListLayout", ddFrame)
                ddLayout.Padding = UDim.new(0,2)
                local ddPad = Instance.new("UIPadding", ddFrame)
                ddPad.PaddingTop = UDim.new(0,4)
                ddPad.PaddingLeft = UDim.new(0,4)
                ddPad.PaddingRight = UDim.new(0,4)

                for _, opt in ipairs(doptions) do
                    local ob = Instance.new("TextButton", ddFrame)
                    ob.Size = UDim2.new(1,0,0,24)
                    ob.BackgroundColor3 = opt == cur and Theme.AccentDark or Theme.SurfaceHigh
                    ob.Text = opt
                    ob.TextColor3 = opt == cur and Color3.new(1,1,1) or Theme.TextDim
                    ob.Font = Enum.Font.Gotham
                    ob.TextSize = 11
                    ob.BorderSizePixel = 0
                    corner(ob, 5)
                    ob.MouseButton1Click:Connect(function()
                        cur = opt
                        selBtn.Text = opt .. " ▾"
                        pcall(dcb, opt)
                        ddFrame:Destroy(); ddFrame = nil; ddOpen = false
                    end)
                end
            end)

            local obj = {}
            function obj:Set(v) cur = v; selBtn.Text = v .. " ▾" end
            function obj:Get() return cur end
            return obj
        end

        -- Textbox
        local function addTextbox(tbcfg)
            tbcfg = tbcfg or {}
            local tbname = tbcfg.Title or tbcfg.Name or "Textbox"
            local tbph   = tbcfg.Placeholder or "Enter text..."
            local tbval  = tbcfg.Value or ""
            local tbcb   = tbcfg.Callback or function() end
            local tbclear= tbcfg.ClearTextOnFocus or tbcfg.ClearOnFocus or false

            local f = rowFrame(48)
            local tl2 = label(f, tbname, 12, Theme.Text, Enum.Font.GothamBold)
            tl2.Size = UDim2.new(1,-20,0,16)
            tl2.Position = UDim2.new(0,12,0,6)

            local inputBg = makeFrame(f, UDim2.new(1,-24,0,22), UDim2.new(0,12,0,26), Theme.BG)
            corner(inputBg, 5)
            stroke(inputBg, Theme.Border, 1)

            local ti = Instance.new("TextBox", inputBg)
            ti.Size = UDim2.new(1,-10,1,0)
            ti.Position = UDim2.new(0,5,0,0)
            ti.BackgroundTransparency = 1
            ti.Text = tbval
            ti.PlaceholderText = tbph
            ti.PlaceholderColor3 = Theme.TextDim
            ti.TextColor3 = Theme.Text
            ti.Font = Enum.Font.Gotham
            ti.TextSize = 11
            ti.TextXAlignment = Enum.TextXAlignment.Left
            ti.ClearTextOnFocus = tbclear
            ti.BorderSizePixel = 0

            ti.FocusLost:Connect(function(enter)
                if enter then pcall(tbcb, ti.Text) end
                tween(inputBg, {BackgroundColor3=Theme.BG}, 0.1)
            end)
            ti.Focused:Connect(function()
                tween(inputBg, {BackgroundColor3=Theme.SurfaceHigh}, 0.1)
                stroke(inputBg, Theme.Accent, 1)
            end)

            local obj = {}
            function obj:Set(v) ti.Text = v end
            function obj:Get() return ti.Text end
            return obj
        end

        -- Label
        local function addLabel(lcfg)
            lcfg = lcfg or {}
            local ltext = lcfg.Title or lcfg.Text or lcfg.Content or ""
            local f = makeFrame(sf, UDim2.new(1,0,0,28), nil, Theme.BG, 1)
            local l2 = label(f, ltext, 11, Theme.TextDim)
            l2.Size = UDim2.new(1,-16,1,0)
            l2.Position = UDim2.new(0,8,0,0)
            local obj = {}
            function obj:SetCode(v) l2.Text = v end
            function obj:Set(v) l2.Text = v end
            return obj
        end

        -- Paragraph
        local function addParagraph(pcfg)
            pcfg = pcfg or {}
            local ptitle = pcfg.Title or ""
            local pbody  = pcfg.Content or pcfg.Desc or ""
            local f = rowFrame(math.max(40, #pbody/2))
            f.Size = UDim2.new(1,0,0,math.max(48, math.ceil(#pbody/45)*16+22))
            if ptitle ~= "" then
                local tl2 = label(f, ptitle, 12, Theme.TextAccent, Enum.Font.GothamBold)
                tl2.Size = UDim2.new(1,-20,0,18)
                tl2.Position = UDim2.new(0,12,0,6)
            end
            local bl = label(f, pbody, 11, Theme.TextDim)
            bl.Size = UDim2.new(1,-24,1,-28)
            bl.Position = UDim2.new(0,12,0,ptitle ~= "" and 24 or 8)
            bl.TextWrapped = true
        end

        -- Code (status display)
        local function addCode(ccfg)
            ccfg = ccfg or {}
            local ctitle = ccfg.Title or ""
            local ccode  = ccfg.Code or ""
            local f = rowFrame(48)

            local tl2 = label(f, ctitle, 11, Theme.TextDim, Enum.Font.GothamBold)
            tl2.Size = UDim2.new(1,-20,0,16)
            tl2.Position = UDim2.new(0,12,0,6)

            local codeBg = makeFrame(f, UDim2.new(1,-24,0,20), UDim2.new(0,12,0,24), Color3.fromRGB(10,10,15))
            corner(codeBg, 4)
            local codeL = label(codeBg, ccode, 11, Theme.AccentGlow, Enum.Font.Code)
            codeL.Size = UDim2.new(1,-8,1,0)
            codeL.Position = UDim2.new(0,4,0,0)

            local obj = {}
            function obj:SetCode(v) codeL.Text = v end
            function obj:Set(v) codeL.Text = v end
            return obj
        end

        -- Keybind
        local function addKeybind(kcfg)
            kcfg = kcfg or {}
            local kname = kcfg.Title or kcfg.Name or "Keybind"
            local kdef  = kcfg.Default or Enum.KeyCode.Unknown
            local kcb   = kcfg.Callback or function() end

            local f = rowFrame(36)
            local tl2 = label(f, kname, 12, Theme.Text, Enum.Font.GothamBold)
            tl2.Size = UDim2.new(0.6,0,0,18)
            tl2.Position = UDim2.new(0,12,0.5,-9)

            local kbBtn = Instance.new("TextButton", f)
            kbBtn.Size = UDim2.new(0,80,0,22)
            kbBtn.Position = UDim2.new(1,-88,0.5,-11)
            kbBtn.BackgroundColor3 = Theme.SurfaceHigh
            kbBtn.Text = tostring(kdef):gsub("Enum.KeyCode.","")
            kbBtn.TextColor3 = Theme.Accent
            kbBtn.Font = Enum.Font.GothamBold
            kbBtn.TextSize = 11
            kbBtn.BorderSizePixel = 0
            corner(kbBtn, 5)
            stroke(kbBtn, Theme.Border, 1)

            local cur = kdef
            local listening = false
            kbBtn.MouseButton1Click:Connect(function()
                listening = true
                kbBtn.Text = "..."
                kbBtn.TextColor3 = Theme.Warning
            end)
            UserInputService.InputBegan:Connect(function(inp, gpe)
                if not listening then
                    if inp.KeyCode == cur then pcall(kcb) end
                    return
                end
                if inp.UserInputType == Enum.UserInputType.Keyboard then
                    cur = inp.KeyCode
                    kbBtn.Text = tostring(inp.KeyCode):gsub("Enum.KeyCode.","")
                    kbBtn.TextColor3 = Theme.Accent
                    listening = false
                end
            end)
        end

        -- ── Tab method map ─────────────────────────────────────
        -- Both naming styles: AddToggle / Toggle, etc.
        T.AddSection   = addSection;  T.Section   = addSection
        T.AddToggle    = addToggle;   T.Toggle    = addToggle
        T.AddButton    = addButton;   T.Button    = addButton
        T.AddSlider    = addSlider;   T.Slider    = addSlider
        T.AddDropdown  = addDropdown; T.Dropdown  = addDropdown
        T.AddTextBox   = addTextbox;  T.AddTextbox= addTextbox; T.Textbox = addTextbox
        T.AddLabel     = addLabel;    T.Label     = addLabel
        T.AddParagraph = addParagraph;T.Paragraph = addParagraph
        T.AddKeybind   = addKeybind;  T.Keybind   = addKeybind
        T.Code         = addCode;     T.AddCode   = addCode

        -- register + click
        table.insert(W._tabs, T)
        btn.MouseButton1Click:Connect(function() activateTab(T) end)
        if #W._tabs == 1 then activateTab(T) end

        return T
    end

    -- expose both naming styles
    W.Tab      = buildTab
    W.MakeTab  = buildTab
    W.CreateTab= buildTab

    -- NewMinimizer / CreateMobileMinimizer (stubs — just keybind)
    function W:NewMinimizer(cfg2)
        if cfg2 and cfg2.KeyCode then keybind = cfg2.KeyCode end
    end
    function W:CreateMobileMinimizer() end

    return W
end

-- ── Alias: Library(cfg) → Library:Window(cfg) ─────────────────
setmetatable(Library, {
    __call = function(self, cfg) return self:Window(cfg) end
})

return Library
