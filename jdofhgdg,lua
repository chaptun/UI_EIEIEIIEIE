-- ── Theme ─────────────────────────────────────────────────────
local Theme = {
    BG          = Color3.fromRGB(15, 15, 20),
    Surface     = Color3.fromRGB(22, 22, 30),
    SurfaceHigh = Color3.fromRGB(30, 30, 42),
    Border      = Color3.fromRGB(50, 50, 70),
    Accent      = Color3.fromRGB(80, 130, 255),
    AccentDark  = Color3.fromRGB(50, 90, 200),
    AccentGlow  = Color3.fromRGB(100, 160, 255),
    Text        = Color3.fromRGB(230, 230, 240),
    TextDim     = Color3.fromRGB(140, 140, 160),
    TextAccent  = Color3.fromRGB(180, 210, 255),
    Success     = Color3.fromRGB(80, 210, 120),
    Warning     = Color3.fromRGB(255, 190, 60),
